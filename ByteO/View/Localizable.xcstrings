    "purple_line_level1_encryptedText" : {
      "extractionState" : "migrated",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بايتو، إذا دخلت إلى OHTYH، سألون المسارات بدمك.\nالمفتاح: -7"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ByteO, If step into OHTYH. I’ll paint the tracks with your blood.\nThe Key: -7"
          }
        }
      }
    },
    "purple_line_level1_hint" : {
      "extractionState" : "migrated",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
